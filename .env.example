FLASK_ENV=development
SECRET_KEY=some-super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-super-secret-key-change-in-production
DATABASE_URL=sqlite:///database.db

# Google Auth Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Email Configuration (For production verification and reset emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-smtp-username@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_DEFAULT_SENDER=no-reply@voxai-studio.com

# ElevenLabs Integration (Optional - for advanced premium voices)
ELEVEN_LABS_API_KEY=your-eleven-labs-api-key

